# ==============================================================================
# IntentGuard Environment Configuration (Research & Simulation Prototype)
# NOTE: THIS IS A SIMULATION ONLY - NEVER USE REAL FINANCIAL CREDENTIALS
# ==============================================================================

# Application Environment
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO

# Database Configuration
# Default to SQLite for zero-setup local research development
DATABASE_URL=sqlite:///./intentguard.db
# For PostgreSQL container:
# DATABASE_URL=postgresql://intentguard:intentguard_secret@localhost:5432/intentguard_db

# Backend Gateway Service Configuration
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
GATEWAY_URL=http://127.0.0.1:8000

# Mock Payment Service Configuration (Simulated Sandbox)
PAYMENT_SERVICE_HOST=127.0.0.1
PAYMENT_SERVICE_PORT=8001
PAYMENT_SERVICE_URL=http://127.0.0.1:8001

# Transaction Protocol Policy Configuration
DEFAULT_TIMEOUT_SECONDS=3.0
RECONCILIATION_INTERVAL_SECONDS=2.0
MAX_ATTEMPTS_PER_INTENT=3
DEFAULT_CURRENCY=INR
RECONCILIATION_QUERY_LIMIT=50
EXPERIMENT_DEFAULT_SEED=42

# Optional LLM Integration Adapter (offline, gemini, openai, ollama)
# Offline rule-based scripted parsing is enabled by default (no API key required)
LLM_PROVIDER=offline
GEMINI_API_KEY=
OPENAI_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434
LLM_MODEL=gemini-1.5-flash

# Frontend Configuration
FRONTEND_PORT=3000
VITE_API_URL=http://127.0.0.1:8000
