# Database Configuration
DATABASE_URL=sqlite:///./intentguard.db
# For PostgreSQL:
# DATABASE_URL=postgresql://intentguard:intentguard_secret@localhost:5432/intentguard_db

# Gateway Service
GATEWAY_HOST=127.0.0.1
GATEWAY_PORT=8000

# Mock Payment Service
PAYMENT_SERVICE_HOST=127.0.0.1
PAYMENT_SERVICE_PORT=8001
PAYMENT_SERVICE_URL=http://127.0.0.1:8001

# Operational Parameters
DEFAULT_TIMEOUT_SECONDS=3.0
RECONCILIATION_INTERVAL_SECONDS=2.0
MAX_ATTEMPTS_PER_INTENT=3

# Optional LLM API Keys (for live agent tool-calling)
GEMINI_API_KEY=
OPENAI_API_KEY=
