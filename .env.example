# IntentGuard configuration (simulation only - never use real payment credentials)

# Gateway database: SQLite for zero setup, or PostgreSQL
DATABASE_URL=sqlite:///./intentguard_gateway.db
# DATABASE_URL=postgresql+psycopg://intentguard:intentguard_secret@localhost:5432/intentguard_db

# Payment provider: "http" talks to provider_api on PAYMENT_SERVICE_URL,
# "inprocess" embeds the simulator in the gateway process.
PAYMENT_PROVIDER=http
PAYMENT_SERVICE_URL=http://127.0.0.1:8001
PROVIDER_TIMEOUT_S=5

# Protocol parameters
ABSENCE_WINDOW_S=30
MAX_ATTEMPTS=3
UNKNOWN_REVIEW_AFTER_S=300
POLL_INTERVAL_S=5
WORKER_INTERVAL_S=2

# Seed demo users and orders (ORD-204 / ORD-240 near-miss IDs) on first start. Sandbox only.
# Demo users log in with DEMO_PASSWORD (default: intentguard-demo).
DEMO_SEED=true
# DEMO_PASSWORD=
# Without the demo seed, the first admin is created from these when no user exists.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Simulator-only endpoints (fault injection, ground-truth ledger). Never enable outside a sandbox.
SIMULATOR_MODE=true

# Authentication: JWT_SECRET needs at least 32 random bytes. `python scripts/init_env.py` (run by
# scripts/start.bat) fills it in. Empty = a random per-process secret: logins end on restart.
JWT_SECRET=
# Refresh-token cookie is Secure (browsers accept it on http://localhost).
COOKIE_SECURE=true

# Provider webhooks: shared HMAC secret (filled in by scripts/init_env.py). Empty disables webhooks.
WEBHOOK_SECRET=
PAYSIM_WEBHOOK_URL=http://127.0.0.1:8000/api/webhooks/paysim

# Provider simulator
PAYSIM_STATE_PATH=paysim_state.json
PAYSIM_SETTLE_DELAY_S=3

# Optional LLM agent / reviewer: offline | openai | ollama | gemini
LLM_PROVIDER=offline
LLM_MODEL=
OPENAI_API_KEY=
GEMINI_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434
